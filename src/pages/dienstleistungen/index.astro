---
import Base from '../../layouts/Base.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';
import Cta from '../../components/Cta.astro';
import { Image } from 'astro:assets';
import { seite } from '../../lib/inhalte';
import { text, textAbsaetze, klartext, slug } from '../../lib/text';
import { breadcrumbSchema, serviceSchema } from '../../lib/schema';

// Leistungen und Texte aus src/content/seiten/dienstleistungen.md (Redaktions-Tool)
const t = await seite('dienstleistungen');
const norm = (l: ReturnType<typeof t.l>[number]) => ({ ...l, id: l.id || slug(l.titel), titel: l.titel ?? '', text: l.text ?? '', serviceType: l.serviceType || l.titel || '' });
const kern = t.l('kern').map(norm);
const rund = t.l('rund').map(norm);
const [k, r, offen, cta] = ['kern', 'rund', 'offen', 'cta'].map(t.a);

const schema = [
  breadcrumbSchema([{ name: 'Start', path: '/' }, { name: 'Dienstleistungen', path: '/dienstleistungen/' }]),
  ...[...kern, ...rund].map((l) => serviceSchema(l)),
];
---
<Base title={t.seoTitel ?? 'Dienstleistungen'} description={klartext(t.seoBeschreibung)}
  schema={schema}>
  <Seitenkopf eyebrow={t.kopf.eyebrow} title={t.kopf.titel ?? ''} lead={t.kopf.lead} image={t.kopf.bild} imageAlt={t.kopf.bildAlt} focus={t.kopf.fokus} />

  <nav class="wrap sprung" aria-label="Leistungen auf dieser Seite">
    <ul>
      {kern.map((l) => <li><a href={`#${l.id}`}>{l.titel}</a></li>)}
      <li><a href="#rund-ums-bike">{r.titel}</a></li>
    </ul>
  </nav>

  <section class="section kern" aria-labelledby="kern-titel">
    <div class="wrap">
      <span class="eyebrow">{k.eyebrow}</span>
      <h2 id="kern-titel">{k.titel} {k.script && <span class="script">{k.script}</span>}</h2>
      {kern.map((l, i) => (
        <article class:list={['leistung', { 'leistung--rechts': i % 2 === 1 }]} id={l.id}>
          {l.bild && (
            <div class:list={['getaped', 'getaped--eins']}>
              <div class="foto leistung__foto">
                <Image src={l.bild} alt={l.bildAlt ?? ''} style={l.fokus ? `object-position:${l.fokus}` : undefined} widths={[500, 900, 1200]} sizes="(min-width: 56rem) 45vw, 100vw" quality={70} loading={i === 0 ? 'eager' : 'lazy'} />
              </div>
            </div>
          )}
          <div class="leistung__text">
            <p class="leistung__nr" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
            <h3>{l.titel}</h3>
            {l.kurz && <p class="lead" set:html={text(l.kurz)} />}
            <Fragment set:html={textAbsaetze(l.text)} />
            {l.punkte && <ul class="leistung__punkte">{l.punkte.map((p) => <li>{p}</li>)}</ul>}
            <div class="leistung__links">
              <a class="btn" href={`/kontakt/?thema=${encodeURIComponent(l.thema ?? 'Etwas anderes')}`}>Anfragen</a>
              {l.linkText && l.linkZiel && <a class="btn btn--ghost" href={l.linkZiel}>{l.linkText}</a>}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section section--dark" id="rund-ums-bike" aria-labelledby="rund-titel">
    <div class="wrap">
      <span class="eyebrow">{r.eyebrow}</span>
      <h2 id="rund-titel">{r.titel}</h2>
      {r.lead && <p class="lead rund__lead" set:html={text(r.lead)} />}
      <ul class="rund">
        {rund.map((l) => (
          <li id={l.id}>
            <h3>{l.titel}</h3>
            {l.kurz && <p set:html={text(l.kurz)} />}
            {l.linkText && l.linkZiel && <a href={l.linkZiel}>{l.linkText} →</a>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  {offen.text && (
    <section class="section section--paper">
      <div class="wrap narrow">
        <p class="offen-block" set:html={text(offen.text)} />
      </div>
    </section>
  )}

  <Cta title={cta.titel} text={cta.text} />
</Base>

<style>
  .sprung { padding-block: 1.2rem 0; }
  .sprung ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  .sprung a { display: inline-block; font-family: var(--font-display); text-transform: uppercase; letter-spacing: .1em; font-size: .8rem; padding: .4em .9em; border: 1px solid var(--line); border-radius: 99px; text-decoration: none; color: var(--ink); }
  .sprung a:hover { border-color: var(--oliv); color: var(--oliv); }
  .leistung { display: grid; gap: clamp(1.5rem, 4vw, 3.5rem); grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); align-items: center; padding-block: clamp(2rem, 5vw, 3.5rem); scroll-margin-top: 1rem; }
  .leistung + .leistung { border-top: 1px dashed var(--line); }
  @media (min-width: 56rem) { .leistung--rechts > :first-child { order: 2; } }
  .leistung__foto { aspect-ratio: 4 / 3; }
  .leistung__nr { font-family: var(--font-typo); color: var(--stempel); margin: 0 0 .2rem; font-size: 1.1rem; }
  .leistung h3 { font-size: var(--step-2); margin-bottom: .3em; }
  .leistung .lead { font-size: var(--step-0); font-style: italic; color: var(--leder); margin-bottom: .6em; }
  .leistung__punkte { padding-left: 1.1em; margin: 0 0 1.4rem; }
  .leistung__punkte li { margin-bottom: .3em; }
  .leistung__links { display: flex; flex-wrap: wrap; gap: .7rem; }
  .rund__lead { max-width: 44rem; }
  .rund { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; gap: 1px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); background: rgba(239,229,209,.14); border: 1px solid rgba(239,229,209,.14); }
  .rund li { background: var(--leder-tief); padding: 1.3rem 1.2rem 1.4rem; scroll-margin-top: 1rem; }
  .rund h3 { font-size: 1.05rem; letter-spacing: .06em; color: var(--sand-tief); margin-bottom: .4em; }
  .rund p { font-size: var(--step--1); margin-bottom: .6em; color: var(--on-dark); }
  .rund a { font-size: var(--step--1); }
  .leistung:target, .rund li:target { outline: 2px dashed var(--stempel); outline-offset: 6px; }
</style>
