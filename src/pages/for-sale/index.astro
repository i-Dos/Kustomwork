---
import Base from '../../layouts/Base.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';
import FaqListe from '../../components/FaqListe.astro';
import { Image, getImage } from 'astro:assets';
import BikeEintrag from '../../components/BikeEintrag.astro';
import { bikes, faqs } from '../../lib/inhalte';
import { breadcrumbSchema, motorcycleOfferSchema } from '../../lib/schema';
import { site } from '../../config/site';

const liste = await bikes();
const verfuegbar = liste.filter((b) => b.data.status !== 'verkauft');
const verkauft = liste.filter((b) => b.data.status === 'verkauft');
const fragen = await faqs('forsale');
const schema = [
  breadcrumbSchema([{ name: 'Start', path: '/' }, { name: 'For Sale', path: '/for-sale/' }]),
  ...(await Promise.all(verfuegbar.filter((b) => !b.data.platzhalter).map(async (b) => {
    const img = await getImage({ src: b.data.cover, width: 1200, format: 'jpg' });
    return motorcycleOfferSchema({ ...b.data, image: new URL(img.src, site.url).href, path: `/for-sale/#${b.id}` });
  }))),
];
---
<Base title="For Sale" description="Harley-Davidson, Triumph und andere Klassiker zu verkaufen: Kustom-Bikes und Occasionen aus der Werkstatt Gemperle's KustomWork in Meilen, auch in Kommission." schema={schema}>
  <Seitenkopf eyebrow="For Sale" title="Bikes mit Geschichte" lead="Aus der eigenen Werkstatt oder in Kommission. Jedes Bike, das hier steht, kennen wir bis zur letzten Schraube." />

  <section class="section">
    <div class="wrap liste">
      {verfuegbar.map((b, i) => <BikeEintrag bike={b} erstes={i === 0} />)}
    </div>
  </section>

  {verkauft.length > 0 && (
    <section class="section section--dark">
      <div class="wrap">
        <span class="eyebrow">Bereits verkauft</span>
        <h2>Neue Besitzer gefunden</h2>
        <div class="grid grid--3 verkauft">
          {verkauft.map((b) => (
            <figure id={b.id}>
              <div class="foto"><Image src={b.data.cover} alt={b.data.coverAlt} widths={[400, 700]} sizes="(min-width: 48rem) 33vw, 100vw" quality={65} /><span class="stempel stempel--foto">Verkauft</span></div>
              <figcaption>{b.data.title} · {b.data.jahrgang}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section section--paper">
    <div class="wrap narrow">
      <h2>Deine Harley verkaufen?</h2>
      <p class="lead">Wir verkaufen ausgewählte Bikes in Kommission. Schick uns Fotos und ein paar Angaben, wir melden uns.</p>
      <FaqListe faqs={fragen} />
      <p style="margin-top:2rem"><a class="btn" href="/kontakt/?thema=For%20Sale%20%2F%20Occasion">Bike anbieten</a></p>
    </div>
  </section>
</Base>
<style>
  .liste { display: grid; gap: clamp(3rem, 7vw, 5rem); }
  .verkauft figure { margin: 0; }
  .verkauft .foto { aspect-ratio: 4 / 3; }
  .verkauft img { filter: grayscale(.6); }
  figcaption { margin-top: .6rem; font-family: var(--font-display); text-transform: uppercase; letter-spacing: .06em; }
</style>
