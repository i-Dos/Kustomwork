---
import Base from '../../layouts/Base.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';
import Cta from '../../components/Cta.astro';
import { Image } from 'astro:assets';
import { seite } from '../../lib/inhalte';
import { text, klartext } from '../../lib/text';
import { breadcrumbSchema } from '../../lib/schema';

// Texte, Marken und Fotos aus src/content/seiten/bekleidung.md (Redaktions-Tool)
const t = await seite('bekleidung');
const marken = t.w('marken');
const bilder = t.l('bilder').filter((b) => b.bild);
const [m, credit, label, cta] = ['marken', 'credit', 'label', 'cta'].map(t.a);
---
<Base title={t.seoTitel ?? t.kopf.titel ?? ''} description={klartext(t.seoBeschreibung)}
  image={t.kopf.bild} imageAlt={t.kopf.bildAlt}
  schema={[breadcrumbSchema([{ name: 'Start', path: '/' }, { name: 'Bekleidung und Teile', path: '/bekleidung/' }])]}>
  <Seitenkopf eyebrow={t.kopf.eyebrow} title={t.kopf.titel ?? ''} lead={t.kopf.lead} image={t.kopf.bild} imageAlt={t.kopf.bildAlt} focus={t.kopf.fokus} />

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">{m.eyebrow}</span>
      <h2>{m.titel} {m.script && <span class="script">{m.script}</span>}</h2>
      <ul class="marken">{marken.map((m) => <li>{m}</li>)}</ul>
      {m.lead && <p class="lead marken__text" set:html={text(m.lead)} />}

      <div class="laden">
        {bilder.map((b, i) => (
          <div class:list={[{ 'getaped getaped--eins': i % 4 === 0 }, { 'laden--quer': b.gross }]}>
            <figure class="foto laden__bild">
              <Image src={b.bild!} alt={b.bildAlt ?? ''} widths={[400, 700, 1100]} sizes="(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw" quality={68} />
            </figure>
          </div>
        ))}
      </div>
      {credit.text && <p class="credit" set:html={text(credit.text)} />}
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrap six">
      <div>
        <span class="eyebrow">{label.eyebrow}</span>
        <h2>{label.titel}</h2>
        {label.lead && <p class="lead" set:html={text(label.lead)} />}
        <a class="btn btn--ghost" href="/sixnineteen/">{label.button ?? 'Zum Lookbook'}</a>
      </div>
      <p class="six__zahl" aria-hidden="true">619</p>
    </div>
  </section>

  <Cta title={cta.titel} text={cta.text} />
</Base>

<style>
  .marken { list-style: none; padding: 0; margin: 1.5rem 0; display: flex; flex-wrap: wrap; gap: .6rem; }
  .marken li { font-family: var(--font-display); text-transform: uppercase; letter-spacing: .12em; font-size: 1rem; padding: .5em 1em; border: 2px solid var(--ink); border-radius: 3px; background: var(--paper); }
  .marken__text { max-width: 44rem; }
  .laden { display: grid; gap: 1.2rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); margin-top: 2.5rem; grid-auto-flow: dense; }
  .laden__bild { margin: 0; aspect-ratio: 2 / 3; height: 100%; }
  .laden--quer { grid-column: span 2; }
  .laden--quer .laden__bild { aspect-ratio: auto; }
  @media (max-width: 40rem) { .laden--quer { grid-column: auto; } .laden--quer .laden__bild { aspect-ratio: 3 / 2; } }
  .credit { margin-top: 1rem; font-size: var(--step--1); color: var(--muted); }
  .six { display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
  .six .lead { max-width: 34rem; }
  .six__zahl { font-family: var(--font-display); font-weight: 700; font-size: clamp(6rem, 18vw, 12rem); line-height: .8; margin: 0; color: rgba(239,229,209,.12); }
</style>
