---
import Base from '../../layouts/Base.astro';
import { site } from '../../config/site';
import { render } from 'astro:content';
import { seite } from '../../lib/inhalte';
const t = await seite('impressum');
const { Content } = await render(t.eintrag);
---
<Base title="Impressum" noindex>
  <section class="section"><div class="narrow prose">
    <h1>{t.kopf.titel ?? 'Impressum'}</h1>
    <h2>Betreiber</h2>
    <p>{site.name}<br />{site.legal.responsible}<br />{site.address.street}<br />{site.address.zip} {site.address.city}<br />Schweiz</p>
    <p>Telefon: <a href={`tel:${site.phoneHref}`}>{site.phone}</a><br />E-Mail: <a href={`mailto:${site.email}`}>{site.email}</a></p>
    {site.legal.uid ? <p>UID: {site.legal.uid}</p> : <p class="offen-block">Offen: Rechtsform und UID-Nummer (falls vorhanden) ergänzen.</p>}
    <Content />
  </div></section>
</Base>
