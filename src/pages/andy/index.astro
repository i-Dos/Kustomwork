---
import Base from '../../layouts/Base.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';
import Cta from '../../components/Cta.astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import { seite } from '../../lib/inhalte';
import { text, klartext, mitErgaenzungen } from '../../lib/text';
import { breadcrumbSchema, personSchema } from '../../lib/schema';

const t = await seite('andy');
const { Content } = await render(t.eintrag);
const html = mitErgaenzungen(t.eintrag.rendered?.html ?? '', t.ergaenzungen);
const zs = t.a('zeitstrahl');
const cta = t.a('cta');
const meilensteine = t.l('meilensteine');
---
<Base title={t.seoTitel ?? t.kopf.titel ?? 'Andy'} description={klartext(t.seoBeschreibung)}
  image={t.kopf.bild} imageAlt={t.kopf.bildAlt}
  schema={[breadcrumbSchema([{ name: 'Start', path: '/' }, { name: 'Andy', path: '/andy/' }]), personSchema()]}>
  <Seitenkopf eyebrow={t.kopf.eyebrow} title={t.kopf.titel ?? ''} lead={t.kopf.lead} image={t.kopf.bild} imageAlt={t.kopf.bildAlt} focus={t.kopf.fokus} />

  <section class="section">
    <div class="wrap andy">
      <div class="prose andy__text">
        <Fragment set:html={html} />
        {t.a('unterschrift').text && <p class="unterschrift">{t.a('unterschrift').text}</p>}
      </div>

      <aside class="zeitstrahl" aria-labelledby="zs-titel">
        <h2 id="zs-titel">{zs.titel ?? 'Meilensteine'}</h2>
        <ol>
          {meilensteine.map((m) => (
            <li><span class:list={['jahr', { offen: !m.jahr || m.jahr === '[OFFEN]' }]}>{!m.jahr || m.jahr === '[OFFEN]' ? 'Jahr?' : m.jahr}</span><span set:html={text(m.text)} /></li>
          ))}
        </ol>
        {zs.bild && (
          <div class="getaped getaped--eins zeitstrahl__band">
            <div class="foto zeitstrahl__foto">
              <Image src={zs.bild} alt={zs.bildAlt ?? ''} widths={[400, 700]} sizes="22rem" quality={72} style={zs.fokus ? `object-position:${zs.fokus}` : undefined} />
            </div>
          </div>
        )}
      </aside>
    </div>
  </section>

  <section class="section section--dark werte">
    <div class="wrap grid grid--3">
      {t.l('werte').map((w) => <div><h3>{w.titel}</h3><p set:html={text(w.text)} /></div>)}
    </div>
  </section>

  <Cta title={cta.titel} text={cta.text} />
</Base>

<style>
  .andy__text > :global(p:first-child) { font-size: var(--step-1); line-height: 1.5; color: var(--leder-tief); }
  .andy { display: grid; gap: 3rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 62rem) { .andy { grid-template-columns: minmax(0, 1fr) 22rem; align-items: start; } }
  .zeitstrahl h2 { font-size: var(--step-1); letter-spacing: .1em; }
  ol { list-style: none; padding: 0; margin: 0 0 2rem; border-left: 2px solid var(--oliv); }
  li { display: grid; gap: .15rem; padding: 0 0 1.1rem 1.1rem; position: relative; font-size: var(--step--1); }
  li::before { content: ''; position: absolute; left: -7px; top: .35em; width: 12px; height: 12px; border-radius: 50%; background: var(--sand); border: 2px solid var(--oliv); }
  .jahr { font-family: var(--font-display); font-size: 1.15rem; color: var(--leder); letter-spacing: .04em; }
  .jahr.offen { color: #b07a28; }
  .zeitstrahl__foto { aspect-ratio: 4 / 5; }
  .werte h3 { color: var(--on-dark); }
</style>
