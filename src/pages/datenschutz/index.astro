---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { seite } from '../../lib/inhalte';
const t = await seite('datenschutz');
const { Content } = await render(t.eintrag);
---
<Base title="Datenschutz" noindex>
  <section class="section"><div class="narrow prose">
    <h1>{t.kopf.titel ?? 'Datenschutz'}</h1>
    <Content />
  </div></section>
</Base>
