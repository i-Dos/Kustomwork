---
import Base from '../../layouts/Base.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';
import Karte from '../../components/Karte.astro';
import { beitraege, seite } from '../../lib/inhalte';
import { klartext } from '../../lib/text';
import { datum } from '../../lib/fotos';
import { breadcrumbSchema } from '../../lib/schema';
const posts = await beitraege();
const t = await seite('blog');
const [erster, ...rest] = posts;
---
<Base title={t.seoTitel ?? 'Blog'} description={klartext(t.seoBeschreibung)}
  schema={[breadcrumbSchema([{ name: 'Start', path: '/' }, { name: 'Blog', path: '/blog/' }])]}>
  <Seitenkopf eyebrow={t.kopf.eyebrow} title={t.kopf.titel ?? ''} lead={t.kopf.lead} image={t.kopf.bild} imageAlt={t.kopf.bildAlt} focus={t.kopf.fokus} />
  <section class="section">
    <div class="wrap">
      {erster && (
        <div class="erster">
          <Karte href={`/blog/${erster.id}/`} image={erster.data.cover} alt={erster.data.coverAlt} kicker={datum(erster.data.date)} title={erster.data.title} text={erster.data.description} ratio="16 / 9" />
        </div>
      )}
      <div class="grid grid--3">
        {rest.map((p) => <Karte href={`/blog/${p.id}/`} image={p.data.cover} alt={p.data.coverAlt} kicker={datum(p.data.date)} title={p.data.title} text={p.data.description} ratio="3 / 2" />)}
      </div>
    </div>
  </section>
</Base>
<style>
  .erster { margin-bottom: 3rem; max-width: 56rem; }
  .erster :global(h3) { font-size: var(--step-2); }
</style>
