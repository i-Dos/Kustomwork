<style>
  .gk { display: block; width: 100%; height: auto; }
  .gk--fuss { position: absolute; left: 0; right: 0; bottom: calc(100% - 1px); height: clamp(4.5rem, 9vw, 9rem); pointer-events: none; }
  .gk__huegel { fill: var(--leder-tief); opacity: .45; }
  .gk__vorne { fill: var(--leder-tief); }
  .gk__kreuz { stroke: var(--leder-tief); stroke-width: 1.5; fill: none; }
  .gk__wellen { fill: none; stroke: var(--sand); stroke-opacity: .22; stroke-width: 1.2; stroke-linecap: round; }
  .gk__faehre { fill: var(--sand); opacity: .22; }
  .gk--linie { color: var(--leder); opacity: .65; margin-block: 2.5rem; }
  .gk__l { fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linejoin: round; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .gk__deck { fill: var(--gk-grund, var(--sand)); }
  .gk__w { opacity: .55; }
</style>
