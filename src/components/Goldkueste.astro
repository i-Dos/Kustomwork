---
/**
 * Silhouette der Zürcher Goldküste (Meilen), erzeugt mit scripts/goldkueste.py.
 * variante «fuss»: gefüllt, sitzt oben auf der Fusszeile. «linie»: feine Trennlinie.
 * Als <img> eingebunden: einmal geladen, danach aus dem Cache, HTML bleibt schlank.
 */
interface Props { variante?: 'fuss' | 'linie'; class?: string }
const { variante = 'linie', class: klasse } = Astro.props;
---
{variante === 'fuss'
  ? <img class:list={['gk gk--fuss', klasse]} src="/grafik/goldkueste-fuss.svg" alt="" width="1600" height="210" loading="lazy" decoding="async" />
  : <img class:list={['gk gk--linie', klasse]} src="/grafik/goldkueste-linie.svg" alt="Zeichnung der Goldküste bei Meilen mit Pfannenstiel, Kirche und Fähre" width="1600" height="210" loading="lazy" decoding="async" />}

<style>
  .gk { display: block; width: 100%; height: auto; }
  .gk--fuss { position: absolute; left: 0; right: 0; bottom: calc(100% - 1px); height: auto; min-height: 3.5rem; object-fit: cover; object-position: center bottom; pointer-events: none; }
  .gk--linie { margin-block: 2.5rem; opacity: .45; }
</style>
