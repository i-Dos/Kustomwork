---
/**
 * Datenblatt als Werkstatt-Bauzettel: Schreibmaschine, Teilenummern, Stempel.
 * Werte mit «[OFFEN]» werden als offene Punkte markiert.
 */
interface Props { titel?: string; nummer: string; zeilen: { label: string; wert: string }[]; stempel?: string; kopf?: string }
const { titel = 'Datenblatt', nummer, zeilen, stempel, kopf = "Gemperle's KustomWork · Bauzettel" } = Astro.props;
const id = `bz-${nummer.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const offen = (w: string) => w.startsWith('[OFFEN]');
---
<aside class="bauzettel" aria-labelledby={id}>
  <p class="bz__kopf"><span>{kopf}</span><span class="bz__nr">Nr. {nummer}</span></p>
  <h2 id={id}>{titel}</h2>
  <dl>
    {zeilen.map((z, i) => (
      <div class="bz__zeile">
        <dt><span class="bz__pos" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{z.label}</dt>
        <dd>{offen(z.wert) ? <><span class="offen">Offen</span> {z.wert.replace('[OFFEN]', '').trim()}</> : z.wert}</dd>
      </div>
    ))}
  </dl>
  {stempel && <p class="stempel bz__stempel">{stempel}</p>}
</aside>

<style>
  .bauzettel {
    position: relative; overflow: hidden; padding: 1.6rem 1.4rem 2rem;
    background-color: #f5eedd;
    background-image:
      linear-gradient(90deg, transparent 2.6rem, rgba(138,58,34,.28) 2.6rem, rgba(138,58,34,.28) calc(2.6rem + 1px), transparent calc(2.6rem + 1px)),
      var(--grain);
    box-shadow: 0 1px 0 rgba(0,0,0,.05), 0 10px 24px -12px rgba(40,25,10,.45);
    border-radius: 2px; transform: rotate(.4deg);
    font-family: var(--font-typo); font-size: .92rem; line-height: 1.5; color: #2c241c;
  }
  .bz__kopf {
    display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin: 0 0 .9rem;
    font-family: var(--font-display); text-transform: uppercase; letter-spacing: .14em; font-size: .7rem; color: var(--muted);
    border-bottom: 2px solid var(--ink); padding-bottom: .5rem;
  }
  .bz__nr { font-family: var(--font-typo); letter-spacing: .04em; font-size: .85rem; color: var(--ink); }
  h2 { font-size: var(--step-1); letter-spacing: .1em; margin-bottom: .6rem; }
  dl { margin: 0; }
  .bz__zeile { padding: .55rem 0 .45rem; border-bottom: 1px dashed rgba(110,69,39,.35); }
  dt { font-family: var(--font-display); text-transform: uppercase; letter-spacing: .12em; font-size: .74rem; color: var(--oliv); display: flex; gap: .7rem; align-items: baseline; }
  .bz__pos { font-family: var(--font-typo); color: var(--stempel); letter-spacing: 0; font-size: .8rem; min-width: 1.4rem; }
  dd { margin: .15rem 0 0 2.1rem; }
  .bz__stempel { position: absolute; right: 1.2rem; top: 3.6rem; font-size: 1.05rem; }
  .offen { font-size: .7rem; }
</style>
