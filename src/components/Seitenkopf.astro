---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
interface Props { eyebrow?: string; title: string; lead?: string; image?: ImageMetadata; imageAlt?: string; focus?: string; focusMobile?: string; ganz?: boolean }
const { eyebrow, title, lead, image, imageAlt = '', focus = '50% 50%', focusMobile, ganz = false } = Astro.props;
// ganz = Bild möglichst vollständig zeigen (breites Bild im Format 3:1): Computer ohne Zoom, Handy als Bildstreifen über dem Text
---
<section class:list={['kopfbild', { 'kopfbild--foto korn': image, 'kopfbild--ganz': image && ganz }]}>
  {image && (
    <Picture src={image} alt={imageAlt} widths={[640, 1280, 1920]} sizes="100vw" formats={['avif', 'webp']} quality={72}
      loading="eager" fetchpriority="high" class="kopfbild__img" style={`--fokus:${focus};--fokus-mobil:${focusMobile || focus}`} />
  )}
  <div class="wrap kopfbild__text">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .kopfbild { position: relative; background: var(--leder-tief) var(--grain); color: var(--on-dark); isolation: isolate; }
  .kopfbild__text { position: relative; z-index: 2; padding-block: clamp(3rem, 8vw, 6rem) clamp(2.5rem, 6vw, 4.5rem); }
  .kopfbild--foto { min-height: clamp(22rem, 60vh, 38rem); display: grid; align-items: end; }
  .kopfbild :global(.kopfbild__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; object-position: var(--fokus); }
  @media (max-width: 40rem) { .kopfbild :global(.kopfbild__img) { object-position: var(--fokus-mobil); } }
  .kopfbild--foto::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(to top, rgba(26,18,11,.9), rgba(26,18,11,.25) 65%); }
  h1 { font-size: var(--step-4); max-width: 16ch; }
  .lead { color: var(--on-dark); max-width: 40rem; }
  .eyebrow { color: var(--sand-tief); }
  /* Variante «ganz»: weniger Zoom, die ganze Illustration bleibt sichtbar */
  .kopfbild--ganz { min-height: 0; aspect-ratio: 3 / 1; }
  .kopfbild--ganz::after { background: linear-gradient(to right, rgba(26,18,11,.55), rgba(26,18,11,.2) 45%, rgba(26,18,11,0) 70%), linear-gradient(to top, rgba(26,18,11,.55), transparent 40%); }
  .kopfbild--ganz .kopfbild__text { align-self: center; padding-block: 2.5rem; }
  .kopfbild--ganz h1 { font-size: clamp(2.2rem, 4.2vw, 4.4rem); max-width: 13ch; }
  .kopfbild--ganz .lead { max-width: 30rem; }
  @media (max-width: 52rem) {
    .kopfbild--ganz { aspect-ratio: auto; display: block; }
    .kopfbild--ganz :global(.kopfbild__img) { position: static; display: block; height: auto; aspect-ratio: 16 / 9; object-position: var(--fokus-mobil); }
    .kopfbild--ganz::after { display: none; }
    .kopfbild--ganz .kopfbild__text { padding-block: 2rem 2.5rem; }
  }
</style>
