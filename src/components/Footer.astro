---
import { site } from '../config/site';
import Goldkueste from './Goldkueste.astro';
const year = new Date().getFullYear();
---
<footer class="fuss section--dark">
  <Goldkueste variante="fuss" />
  <div class="wrap fuss__grid">
    <div>
      <img src={site.logo.hell} alt={`Logo ${site.name}`} width="170" height="153" class="fuss__logo" loading="lazy" />
      <p>{site.tagline}.<br />Kustom-Umbauten, Occasionen und das Label Sixnineteen.</p>
    </div>
    <div>
      <h2 class="fuss__h">Werkstatt</h2>
      <address>
        {site.address.street}<br />{site.address.zip} {site.address.city}<br />
        <a href={`tel:${site.phoneHref}`}>{site.phone}</a><br />
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </address>
    </div>
    <div>
      <h2 class="fuss__h">Offen</h2>
      <ul class="fuss__zeiten">
        {site.openingHours.map((o) => <li>{o.label}: {o.opens}–{o.closes}</li>)}
      </ul>
      <p>{site.openingNote}</p>
    </div>
    <div>
      <h2 class="fuss__h">Folgen</h2>
      <ul class="fuss__links">
        {site.social.instagram && <li><a href={site.social.instagram} rel="me noopener" target="_blank">Instagram</a></li>}
        {site.social.facebook && <li><a href={site.social.facebook} rel="me noopener" target="_blank">Facebook</a></li>}
        <li><a href="/blog/">Blog</a> · <a href="/rss.xml">RSS</a></li>
        <li><a href="/sixnineteen/">Sixnineteen</a></li>
      </ul>
    </div>
  </div>
  {site.partners.length > 0 && (
    <div class="wrap fuss__partner">
      <h2 class="fuss__h">Unsere Partner</h2>
      <ul>
        {site.partners.map((p) => (
          <li><a href={p.url} rel="noopener" target="_blank" title={p.name}><img src={p.logo} alt={`Logo ${p.name}`} width={p.w} height={p.h} loading="lazy" decoding="async" /></a></li>
        ))}
      </ul>
    </div>
  )}
  <div class="wrap fuss__unten">
    <span>© {year} {site.name}</span>
    <span><a href={site.legal.impressumPath}>Impressum</a> · <a href={site.legal.datenschutzPath}>Datenschutz</a></span>
  </div>
</footer>

<style>
  .fuss { position: relative; padding-block: 4rem 2rem; font-size: var(--step--1); background: var(--leder-tief) var(--grain); color: var(--on-dark); }
  .fuss a { color: var(--on-dark); }
  .fuss__grid { display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); }
  .fuss__logo { width: 170px; height: auto; margin-bottom: 1rem; }
  .fuss__marke { font-family: var(--font-display); text-transform: uppercase; font-size: 1.5rem; letter-spacing: .04em; margin-bottom: .4em; }
  .fuss__h { font-size: .9rem; letter-spacing: .2em; color: var(--on-dark-muted); margin-bottom: .6em; }
  address { font-style: normal; }
  ul { list-style: none; padding: 0; margin: 0 0 1em; }
  .fuss__partner { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid rgba(239,229,209,.15); }
  .fuss__partner ul { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem clamp(2rem, 5vw, 4rem); margin: 1rem 0 0; }
  .fuss__partner a { display: block; opacity: .6; transition: opacity .2s, transform .2s; }
  .fuss__partner a:hover, .fuss__partner a:focus-visible { opacity: 1; transform: translateY(-2px); }
  .fuss__partner img { height: clamp(2.4rem, 5vw, 3.2rem); width: auto; }
  .fuss__unten {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; margin-top: 2rem; padding-top: 1.5rem;
    border-top: 1px solid rgba(239,229,209,.15); color: var(--on-dark-muted);
  }
</style>
