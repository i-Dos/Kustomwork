---
import { site } from '../config/site';
const path = Astro.url.pathname;
const isHome = path === '/';
---
<header class:list={['kopf', { 'kopf--home': isHome }]}>
  <div class="wrap kopf__inner">
    <a href="/" class="marke" aria-label={`${site.name}, Startseite`}>
      <img src={site.logo.hell} alt="" width="78" height="70" class="marke__logo" fetchpriority={isHome ? 'high' : undefined} />
      <span class="marke__text"><span class="marke__name">Gemperle's</span><span class="marke__kw">KustomWork</span></span>
    </a>
    <nav aria-label="Hauptnavigation">
      <button class="menu-btn" aria-expanded="false" aria-controls="menu">
        <span class="visually-hidden">Menü</span>
        <span class="menu-btn__bars" aria-hidden="true"></span>
      </button>
      <ul id="menu" class="menu">
        {site.nav.map((n) => (
          <li><a href={n.href} data-astro-prefetch="viewport" aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    document.documentElement.classList.toggle('menu-offen', !open);
  });
</script>

<style>
  .kopf { background: var(--leder-tief); color: var(--on-dark); position: relative; z-index: 20; }
  .kopf--home { position: absolute; inset: 0 0 auto; background: linear-gradient(rgba(20,14,9,.82), rgba(20,14,9,.45) 60%, rgba(20,14,9,0)); }
  .kopf__inner { display: flex; align-items: center; justify-content: space-between; padding-block: .6rem; gap: 1rem; min-height: 4.5rem; }
  .marke { color: var(--on-dark); text-decoration: none; line-height: .9; display: flex; align-items: center; gap: .8rem; }
  .marke__logo { width: 78px; height: auto; display: block; }
  .marke__text { display: grid; }
  /* Startseite: ruhige Kopfzeile, rundes Logo links bündig mit «Kustom», mittig zur Menüzeile */
  .kopf--home .marke__text { display: none; }
  .kopf--home .kopf__inner { padding-block: .9rem; }
  .kopf--home .marke__logo { width: clamp(3.6rem, 5vw, 4.6rem); filter: drop-shadow(0 1px 2px rgba(0,0,0,.5)); }
  @media (max-width: 30rem) { .marke__logo { width: 60px; } .marke__text { display: none; } .kopf--home .marke__logo { width: 3.6rem; } }
  .marke:hover { color: var(--on-dark); }
  .marke__name { font-family: var(--font-body); font-style: italic; font-size: 1.05rem; color: var(--on-dark-muted); }
  .marke__kw { font-family: var(--font-display); font-weight: 700; font-size: 1.7rem; text-transform: uppercase; letter-spacing: .04em; }
  .menu { list-style: none; display: flex; gap: clamp(.8rem, 2vw, 1.8rem); margin: 0; padding: 0; }
  .menu a {
    color: var(--on-dark); text-decoration: none; font-family: var(--font-display);
    text-transform: uppercase; letter-spacing: .14em; font-size: .92rem; padding-block: .4em; border-bottom: 2px solid transparent;
  }
  .menu a:hover, .menu a[aria-current='page'] { border-color: var(--oliv-hell); color: var(--on-dark); }
  .menu-btn { display: none; }

  @media (max-width: 64rem) {
    .menu-btn {
      display: grid; place-items: center; width: 44px; height: 44px; background: none; border: 1px solid var(--on-dark-muted);
      border-radius: var(--radius); cursor: pointer;
    }
    .menu-btn__bars, .menu-btn__bars::before, .menu-btn__bars::after {
      content: ''; display: block; width: 20px; height: 2px; background: var(--on-dark); position: relative; transition: transform .2s;
    }
    .menu-btn__bars::before { position: absolute; top: -6px; }
    .menu-btn__bars::after { position: absolute; top: 6px; }
    :global(.menu-offen) .menu-btn__bars { background: transparent; }
    :global(.menu-offen) .menu-btn__bars::before { transform: translateY(6px) rotate(45deg); }
    :global(.menu-offen) .menu-btn__bars::after { transform: translateY(-6px) rotate(-45deg); }
    .menu {
      display: none; position: absolute; left: 0; right: 0; top: 100%; flex-direction: column; gap: 0;
      background: var(--leder-tief); padding: .5rem var(--gutter) 1.5rem;
    }
    :global(.menu-offen) .menu { display: flex; }
    .menu a { display: block; padding: .8em 0; font-size: 1.1rem; border-bottom: 1px solid rgba(239,229,209,.12); }
  }
</style>
