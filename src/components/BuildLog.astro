---
/**
 * «Build Log / Technik»: technische Werkstatt-Notizen zu einem Bike.
 * offen = Frage an Andy, wird als offener Punkt markiert, bis er die Details liefert.
 */
interface Eintrag { bereich: string; notiz?: string; offen?: string }
interface Props { eintraege: Eintrag[]; titel?: string; link?: { href: string; text: string } }
const { eintraege, titel = 'Build Log / Technik', link } = Astro.props;
---
{eintraege.length > 0 && (
  <section class="buildlog" aria-labelledby="buildlog-titel">
    <p class="eyebrow">Für die Schrauber</p>
    <h2 id="buildlog-titel">{titel}</h2>
    <ol>
      {eintraege.map((e, i) => (
        <li>
          <span class="bl__nr" aria-hidden="true">#{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3>{e.bereich}</h3>
            {e.notiz && <p>{e.notiz}</p>}
            {e.offen && <p class="bl__offen"><span class="offen">Andy ergänzt</span> {e.offen}</p>}
          </div>
        </li>
      ))}
    </ol>
    {link && <p class="bl__link"><a href={link.href}>{link.text}</a></p>}
  </section>
)}

<style>
  .buildlog {
    margin-top: 3rem; padding: 1.6rem clamp(1.1rem, 3vw, 2rem) 1.4rem; position: relative;
    background: var(--leder-tief) var(--grain); color: var(--on-dark); border-radius: 2px;
    box-shadow: inset 0 0 0 1px rgba(239,229,209,.08), inset 0 0 60px rgba(0,0,0,.35);
  }
  .buildlog .eyebrow { color: var(--sand-tief); }
  .buildlog h2 { font-size: var(--step-2); margin: 0 0 1rem; color: var(--on-dark); }
  ol { list-style: none; margin: 0; padding: 0; }
  li { display: grid; grid-template-columns: 3rem 1fr; gap: .4rem; padding: .9rem 0; border-top: 1px dashed rgba(239,229,209,.22); }
  .bl__nr { font-family: var(--font-typo); color: #d9a07a; font-size: 1rem; padding-top: .1rem; }
  h3 { font-size: 1rem; letter-spacing: .12em; margin: 0 0 .25rem; color: var(--sand-tief); }
  li p { margin: 0 0 .35rem; font-family: var(--font-typo); font-size: .95rem; line-height: 1.55; }
  .bl__offen { color: var(--on-dark-muted); }
  .bl__link { margin: .8rem 0 0; }
  .buildlog a { color: var(--on-dark); }
</style>
