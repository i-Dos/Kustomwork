---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
interface Props { href: string; image: ImageMetadata; alt: string; kicker?: string; title: string; text?: string; badge?: string; ratio?: string }
const { href, image, alt, kicker, title, text, badge, ratio = '4 / 3' } = Astro.props;
---
<article class="karte">
  <a href={href} class="karte__link">
    <div class="foto karte__foto" style={`aspect-ratio:${ratio}`}>
      <Image src={image} alt={alt} widths={[400, 700, 1000]} sizes="(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw" quality={70} />
      {badge && <span class="karte__badge">{badge}</span>}
    </div>
    <div class="karte__text">
      {kicker && <p class="karte__kicker">{kicker}</p>}
      <h3>{title}</h3>
      {text && <p>{text}</p>}
      <slot />
    </div>
  </a>
</article>

<style>
  .karte__link { color: inherit; text-decoration: none; display: block; }
  .karte__foto :global(img) { transition: transform .5s ease; }
  .karte__link:hover .karte__foto :global(img) { transform: scale(1.04); }
  .karte__link:hover h3 { color: var(--oliv); }
  .karte__text { padding-top: 1rem; }
  .karte__kicker { font-family: var(--font-display); text-transform: uppercase; letter-spacing: .16em; font-size: .8rem; color: var(--muted); margin-bottom: .3em; }
  .karte h3 { margin-bottom: .3em; transition: color .2s; }
  .karte p { font-size: var(--step--1); margin-bottom: .4em; }
  .karte__badge {
    position: absolute; top: .8rem; left: .8rem; z-index: 2; background: var(--oliv); color: var(--on-dark);
    font-family: var(--font-display); text-transform: uppercase; letter-spacing: .14em; font-size: .75rem; padding: .3em .7em;
  }
  :global(.section--dark) .karte__kicker { color: var(--on-dark-muted); }
  :global(.section--dark) .karte__link:hover h3 { color: var(--oliv-hell); }
</style>
