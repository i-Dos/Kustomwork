---
/**
 * Startseiten-Hero: pro Besuch ein zufälliges Bild aus site.hero.
 * Alle Varianten liegen als <template> im HTML; ein kleines Inline-Skript
 * wählt synchron beim Parsen eine aus. So lädt nur EIN Bild (gut für LCP),
 * ohne Slider und ohne Layout-Sprung. Ohne JavaScript erscheint das erste Bild.
 */
import { Picture } from 'astro:assets';
import { site } from '../config/site';
import { foto } from '../lib/fotos';

interface Props {
  neu?: { label: string; title: string; href: string };
}
const { neu } = Astro.props;
const bilder = site.hero.map((h) => ({ ...h, img: foto(h.src) }));
const pic = { widths: [640, 960, 1280, 1600, 2000], sizes: '100vw', formats: ['avif', 'webp'] as const, quality: 62 };
---
<section class="hero" aria-label="Willkommen">
  <div class="hero__bild korn" id="hero-bild">
    {bilder.map((b, i) => (
      <template data-hero={i}>
        <Picture src={b.img} alt={b.alt} {...pic} formats={[...pic.formats]} loading="eager" fetchpriority="high" style={`object-position:${b.focus}`} />
      </template>
    ))}
    <noscript>
      <Picture src={bilder[0].img} alt={bilder[0].alt} {...pic} formats={[...pic.formats]} loading="eager" style={`object-position:${bilder[0].focus}`} />
    </noscript>
  </div>
  <script is:inline>
    (function () {
      var t = document.querySelectorAll('#hero-bild template');
      var i = Math.floor(Math.random() * t.length);
      try { var last = sessionStorage.getItem('hero'); if (t.length > 1 && String(i) === last) i = (i + 1) % t.length; sessionStorage.setItem('hero', i); } catch (e) {}
      document.getElementById('hero-bild').appendChild(t[i].content.cloneNode(true));
    })();
  </script>

  <div class="wrap hero__text">
    <p class="eyebrow">Harley-Davidson Kustom · Meilen am Zürichsee</p>
    <h1>Kustom<br />statt Katalog.</h1>
    <p class="hero__lead">Harley-Davidson-Umbauten mit selbst gefertigten Teilen, gebaut zum Fahren. Von Andy Gemperle, Schrauber aus Leidenschaft.</p>
    <div class="hero__ctas">
      <a class="btn" href="/projekte/">Projekte ansehen</a>
      <a class="btn btn--ghost" href="/kontakt/">Umbau anfragen</a>
    </div>
  </div>

  {neu && (
    <a class="hero__neu" href={neu.href}>
      <span class="hero__neu-label">{neu.label}</span>
      <span class="hero__neu-title">{neu.title}</span>
      <span aria-hidden="true">→</span>
    </a>
  )}
</section>

<style>
  .hero {
    position: relative; min-height: min(100svh, 62rem); display: grid; align-items: end;
    color: var(--on-dark); background: var(--leder-tief); isolation: isolate;
  }
  .hero__bild { position: absolute; inset: 0; z-index: -1; }
  .hero__bild :global(picture), .hero__bild :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero__bild::after {
    content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(to top, rgba(26,18,11,.92) 0%, rgba(26,18,11,.55) 38%, rgba(26,18,11,.1) 70%),
      radial-gradient(ellipse at center, transparent 55%, rgba(26,18,11,.45));
  }
  .hero__text { padding-block: 9rem 6.5rem; position: relative; z-index: 2; }
  .hero h1 { font-size: var(--step-4); max-width: 12ch; margin-bottom: .35em; }
  .hero__lead { font-size: var(--step-1); max-width: 34rem; line-height: 1.45; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.6rem; }
  .eyebrow { color: var(--on-dark-muted); }
  .hero__neu {
    position: absolute; right: var(--gutter); bottom: 1.5rem; max-width: min(24rem, calc(100% - 2 * var(--gutter)));
    display: grid; grid-template-columns: 1fr auto; column-gap: 1rem; align-items: center;
    background: rgba(239,229,209,.94); color: var(--ink); text-decoration: none; padding: .8rem 1.1rem; border-left: 5px solid var(--oliv);
  }
  .hero__neu:hover { background: var(--paper); color: var(--ink); }
  .hero__neu-label { grid-column: 1; font-family: var(--font-display); text-transform: uppercase; letter-spacing: .2em; font-size: .72rem; color: var(--oliv); }
  .hero__neu-title { grid-column: 1; font-family: var(--font-display); text-transform: uppercase; font-size: 1.05rem; line-height: 1.2; }
  .hero__neu > span:last-child { grid-column: 2; grid-row: 1 / span 2; font-size: 1.4rem; }
  @media (max-width: 40rem) {
    .hero__text { padding-bottom: 8.5rem; }
  }
</style>
