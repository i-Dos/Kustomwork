---
import { site } from '../config/site';
import { seite } from '../lib/inhalte';
import { klartext } from '../lib/text';
interface Props { title?: string; text?: string }
// Standardtexte aus start.md (abschnitte.cta), pro Seite überschreibbar
const std = (await seite('start')).a('cta');
const title = Astro.props.title || std.titel || '';
const text = klartext(Astro.props.text || std.text || '');
---
<section class="section section--oliv cta">
  <div class="wrap cta__inner">
    <div>
      <h2>{title}</h2>
      <p class="lead">{text}</p>
    </div>
    <div class="cta__aktionen">
      <a class="btn btn--ghost" href="/kontakt/">Anfrage senden</a>
      <a class="cta__tel" href={`tel:${site.phoneHref}`}>{site.phone}</a>
    </div>
  </div>
</section>
<style>
  .cta__inner { display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); align-items: end; }
  .cta h2 { font-size: var(--step-3); }
  .cta .lead { color: var(--on-dark); margin: 0; }
  .cta__aktionen { display: flex; flex-wrap: wrap; gap: 1.2rem; align-items: center; justify-content: flex-start; }
  .cta__tel { color: var(--on-dark); font-family: var(--font-display); font-size: var(--step-1); letter-spacing: .06em; text-decoration: none; }
</style>
