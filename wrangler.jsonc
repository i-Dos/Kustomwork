// Cloudflare Workers: Vorschau bis zum Livegang (nicht für Infomaniak nötig)
// Dashboard: Build command `npm run build:vorschau`, Deploy command `npm run deploy:vorschau`
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kustomwork",
  "main": "worker/index.js",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true },
  // Vorschau-Passwort: nur der SHA-256-Hash. Ändern: printf '%s' 'neuesPasswort' | sha256sum
  "vars": { "VORSCHAU_PASSWORT_SHA256": "1e0f486d6c4326f7794039429418284e10a04a6d749ca93d796771a253c4421a" },
  // Im Dashboard gesetzte Variablen bei jedem Build behalten
  "keep_vars": true
}
